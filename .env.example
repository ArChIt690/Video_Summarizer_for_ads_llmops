# ─────────────────────────────────────────────────────────────
# AdAudit — environment template
#
#   cp .env.example .env   and fill in your values.
#   NEVER commit the resulting .env file.
# ─────────────────────────────────────────────────────────────

# ── Azure AI Foundry — reasoning model (Mistral) ─────────────
AZURE_MISTRAL_KEY=
AZURE_MISTRAL_ENDPOINT=https://<your-resource>.services.ai.azure.com
AZURE_MISTRAL_VERSION=2024-05-01-preview
AZURE_MISTRAL_DEPLOYMENT=

# ── Azure OpenAI — embeddings ────────────────────────────────
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# ── Azure AI Search — vector store ───────────────────────────
AZURE_SEARCH_ENDPOINT=https://<your-service>.search.windows.net
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX_NAME=ad-compliance-index

# ── Azure Video Indexer ──────────────────────────────────────
AZURE_VI_NAME=
AZURE_VI_LOCATION=eastus
AZURE_VI_ACCOUNT_ID=
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZURE_STORAGE_CONNECTION_STRING=

# ── Observability — Azure Monitor ────────────────────────────
APPLICATIONINSIGHTS_CONNECTION_STRING=

# ── Observability — LangSmith ────────────────────────────────
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=video-ad-compliance
